{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ghostlabs/friendly-skies-embed",
  "version": "0.1.0",
  "title": "Friendly Skies: Bluesky Post",
  "category": "embed",
  "icon": "format-status",
  "description": "Embed a Bluesky post.",
  "keywords": [
    "bluesky",
    "social",
    "embed",
    "post",
    "bsky"
  ],
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": "system"
    },
    "displayMode": {
      "type": "string",
      "default": "card"
    },
    "showEngagement": {
      "type": "boolean",
      "default": true
    },
    "showTimestamp": {
      "type": "boolean",
      "default": true
    },
    "clickBehavior": {
      "type": "string",
      "default": "new-tab"
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "ghostlabs-friendly-skies",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [
    "file:./style-index.css",
    "ghostlabs-fs-global"
  ],
  "render": "file:./render.php"
}
